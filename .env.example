# ─────────────────────────────────────────────────────────────────────
# MYF AI Agent Web UI - Environment Variables Template
# Copy this file to .env.local to configure custom ports or provider keys
# cp .env.example .env.local
# ─────────────────────────────────────────────────────────────────────

# Port configuration (default: 3111)
PORT=3111

# Provider API Keys (Optional - only required if using Cloud API providers)
# NVIDIA NIM (DGX Cloud)
# NVIDIA_API_KEY=nvapi-...

# OpenRouter (100+ Cloud Models)
# OPENROUTER_API_KEY=sk-or-...

# Moonshot AI (Kimi K2)
# MOONSHOT_API_KEY=sk-...

# DeepSeek Cloud API
# DEEPSEEK_API_KEY=sk-...

# Local Ollama Base URL (default: http://localhost:11434)
# OLLAMA_BASE_URL=http://localhost:11434

# Local llama.cpp Base URL (default: http://localhost:8080/v1)
# LLAMA_CPP_BASE_URL=http://localhost:8080/v1
